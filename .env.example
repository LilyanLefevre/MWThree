# Copy to .env (never committed). Everything is optional.
# Folder shared read-only on top of the shipped maps: zone/<map or language>/mp_*.ff, usermaps/<map>/, main/*.iwd
# MW3_DIR=/path/to/Call of Duty Modern Warfare 3
# Host port, and address it listens on (127.0.0.1 = local only; put a TLS reverse proxy or a tunnel in front)
PORT=4173
BIND=127.0.0.1
# Protects the whole site (HTTP Basic, over TLS only)
# MWTHREE_PASSWORD=
# Cloudflare Tunnel: COMPOSE_PROFILES=tunnel plus the tunnel's token
# COMPOSE_PROFILES=tunnel
# CLOUDFLARED_TOKEN=
