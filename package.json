{
  "name": "mwthree",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/viewer",
    "build": "npm run build -w packages/iw5-core && npm run build -w packages/iw5-collision && npm run build -w packages/viewer",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "predev": "npm run build -w packages/iw5-core"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
